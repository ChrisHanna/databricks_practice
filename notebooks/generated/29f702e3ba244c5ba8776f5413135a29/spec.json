  "task_kind": "analysis",
  "decisions": [
    {
      "key": "objective",
      "value": "Correct hourly equipment-health averages and late-reading inclusion.",
      "status": "confirmed",
      "source": "User prompt",
      "impact": "Business outcome.",
      "severity": "requirements",
      "bindings": {}
    },
    {
      "key": "deliverable",
      "value": "Databricks-ready PySpark pipeline notebook with plans, checks, and distributed execution explanations.",
      "status": "confirmed",
      "source": "User prompt",
      "impact": "Artifact scope.",
      "severity": "requirements",
      "bindings": {
        "outputs": [
          "readings_raw",
          "resolved_readings",
          "hourly_health",
          "hourly_comparison",
          "late_quarantine"
        ]
      }
    },
    {
      "key": "grain",
      "value": "One logical reading per reading_id; physical repeats and corrected versions share identity.",
      "status": "confirmed",
      "source": "User prompt and answer",
      "impact": "Identity resolution.",
      "severity": "requirements",
      "bindings": {}
    },
    {
      "key": "metric",
      "value": "Per machine and UTC event hour averages and independent valid/missing counts for temperature and vibration.",
      "status": "confirmed",
      "source": "User answer",
      "impact": "Aggregation.",
      "severity": "requirements",
      "bindings": {
        "operations": [
          {
            "kind": "filter",
            "name": "eligible_readings",
            "input": "readings_raw",
            "predicate": "arrival_delay_minutes <= 120"
          },
          {
            "kind": "deduplicate",
            "name": "resolved_readings",
            "input": "eligible_readings",
            "keys": [
              "reading_id"
            ],
            "order_by": [
              {
                "column": "reading_version",
                "direction": "desc"
              },
              {
                "column": "arrival_timestamp",
                "direction": "desc"
              }
            ]
          },
          {
            "kind": "derive",
            "name": "resolved_with_hour",
            "input": "resolved_readings",
            "columns": [
              {
                "name": "event_hour",
                "expression": "timestampadd(SECOND, -second(event_timestamp), timestampadd(MINUTE, -minute(event_timestamp), event_timestamp))"
              }
            ]
          },
          {
            "kind": "aggregate",
            "name": "hourly_health",
            "input": "resolved_with_hour",
            "group_by": [
              "site_id",
              "machine_id",
              "event_hour"
            ],
            "measures": [
              {
                "name": "total_reading_count",
                "expression": "count(*)"
              },
              {
                "name": "valid_temperature_count",
                "expression": "count(temperature_c)"
              },
              {
                "name": "missing_temperature_count",
                "expression": "sum(case when temperature_c is null then 1 else 0 end)"
              },
              {
                "name": "avg_temperature_c",
                "expression": "avg(temperature_c)"
              },
              {
                "name": "valid_vibration_count",
                "expression": "count(vibration_mm_s)"
              },
              {
                "name": "missing_vibration_count",
                "expression": "sum(case when vibration_mm_s is null then 1 else 0 end)"
              },
              {
                "name": "avg_vibration_mm_s",
                "expression": "avg(vibration_mm_s)"
              }
            ]
          },
          {
            "kind": "filter",
            "name": "reference_eligible",
            "input": "readings_raw",
            "predicate": "arrival_timestamp <= timestampadd(HOUR, 2, event_timestamp)"
          },
          {
            "kind": "deduplicate",
            "name": "reference_resolved",
            "input": "reference_eligible",
            "keys": [
              "reading_id"
            ],
            "order_by": [
              {
                "column": "reading_version",
                "direction": "desc"
              },
              {
                "column": "arrival_timestamp",
                "direction": "desc"
              }
            ]
          },
          {
            "kind": "derive",
            "name": "reference_with_hour",
            "input": "reference_resolved",
            "columns": [
              {
                "name": "event_hour",
                "expression": "timestampadd(SECOND, -second(event_timestamp), timestampadd(MINUTE, -minute(event_timestamp), event_timestamp))"
              }
            ]
          },
          {
            "kind": "aggregate",
            "name": "hourly_reference",
            "input": "reference_with_hour",
            "group_by": [
              "site_id",
              "machine_id",
              "event_hour"
            ],
            "measures": [
              {
                "name": "ref_total_reading_count",
                "expression": "count(*)"
              },
              {
                "name": "ref_valid_temperature_count",
                "expression": "count(temperature_c)"
              },
              {
                "name": "ref_missing_temperature_count",
                "expression": "sum(case when temperature_c is null then 1 else 0 end)"
              },
              {
                "name": "ref_avg_temperature_c",
                "expression": "avg(temperature_c)"
              },
              {
                "name": "ref_valid_vibration_count",
                "expression": "count(vibration_mm_s)"
              },
              {
                "name": "ref_missing_vibration_count",
                "expression": "sum(case when vibration_mm_s is null then 1 else 0 end)"
              },
              {
                "name": "ref_avg_vibration_mm_s",
                "expression": "avg(vibration_mm_s)"
              }
            ]
          },
          {
            "kind": "join",
            "name": "hourly_comparison",
            "left": "hourly_health",
            "right": "hourly_reference",
            "keys": [
              "site_id",
              "machine_id",
              "event_hour"
            ],
            "how": "left",
            "cardinality": "many_to_one"
          },
          {
            "kind": "filter",
            "name": "too_late_records",
            "input": "readings_raw",
            "predicate": "arrival_timestamp > timestampadd(HOUR, 2, event_timestamp)"
          },
          {
            "kind": "derive",
            "name": "late_quarantine",
            "input": "too_late_records",
            "columns": [
              {
                "name": "quarantine_reason",
                "expression": "'arrival_after_two_hour_cutoff'"
              }
            ]
          }
        ]
      }
    },
    {
      "key": "population",
      "value": "Highest eligible version, latest arrival tie-break; arrivals after two hours quarantined.",
      "status": "confirmed",
      "source": "User answers",
      "impact": "Eligibility.",
      "severity": "requirements",
      "bindings": {}
    },
    {
      "key": "time",
      "value": "Fixed UTC window 2026-01-01 through 2026-01-08; two-hour allowed lateness.",
      "status": "delegated",
      "source": "User unavailable; reproducibility default",
      "impact": "Time boundaries.",
      "severity": "requirements",
      "bindings": {}
    },
    {
      "key": "simulation",
      "value": "10,000 base readings, 3 sites, 12 machines, one 45% volume machine, 5% missing temperature, 3% repeats, 2% corrections, 10% delayed and 1% too late.",
      "status": "confirmed",
      "source": "User prompt plus delegated numeric defaults",
      "impact": "Synthetic evidence.",
      "severity": "requirements",
      "bindings": {
        "tables": [
          {
            "name": "readings_raw",
            "grain": "One physical reading record; repeated rows and corrected versions share reading_id",
            "rows": 10000,
            "primary_key": "reading_id",
            "columns": [
              {
                "name": "reading_id",
                "kind": "id"
              },
              {
                "name": "machine_id",
                "kind": "category",
                "categories": [
                  "machine_01",
                  "machine_02",
                  "machine_03",
                  "machine_04",
                  "machine_05",
                  "machine_06",
                  "machine_07",
                  "machine_08",
                  "machine_09",
                  "machine_10",
                  "machine_11",
                  "machine_12"
                ],
                "weights": [
                  0.45,
                  0.05,
                  0.05,
                  0.05,
                  0.05,
                  0.05,
                  0.05,
                  0.05,
                  0.05,
                  0.05,
                  0.05,
                  0.05
                ]
              },
              {
                "name": "site_id",
                "kind": "expression",
                "expression": "case when machine_id in ('machine_01','machine_02','machine_03','machine_04') then 'site_01' when machine_id in ('machine_05','machine_06','machine_07','machine_08') then 'site_02' else 'site_03' end"
              },
              {
                "name": "event_timestamp",
                "kind": "timestamp",
                "start": "2026-01-01T00:00:00Z",
                "end": "2026-01-08T00:00:00Z"
              },
              {
                "name": "reading_version",
                "kind": "integer",
                "minimum": 1,
                "maximum": 1
              },
              {
                "name": "temperature_c",
                "kind": "decimal",
                "minimum": 40,
                "maximum": 100,
                "null_rate": 0.05
              },
              {
                "name": "vibration_mm_s",
                "kind": "decimal",
                "minimum": 0,
                "maximum": 20
              },
              {
                "name": "arrival_class",
                "kind": "category",
                "categories": [
                  "on_time",
                  "delayed",
                  "too_late"
                ],
                "weights": [
                  0.89,
                  0.1,
                  0.01
                ]
              },
              {
                "name": "arrival_delay_minutes",
                "kind": "expression",
                "expression": "case when arrival_class = 'delayed' then 90 when arrival_class = 'too_late' then 180 else 0 end"
              },
              {
                "name": "arrival_timestamp",
                "kind": "expression",
                "expression": "timestampadd(MINUTE, arrival_delay_minutes, event_timestamp)"
              },
              {
                "name": "microbatch_id",
                "kind": "expression",
                "expression": "floor(timestampdiff(SECOND, to_timestamp('2026-01-01T00:00:00Z'), arrival_timestamp) / 3600)"
              }
            ],
            "duplicate_rate": 0.03,
            "changed_duplicate_rate": 0.02,
            "version_column": "reading_version",
            "duplicate_changes": {
              "temperature_c": "temperature_c + 1.5",
              "vibration_mm_s": "vibration_mm_s + 0.25",
              "arrival_delay_minutes": "arrival_delay_minutes + 30",
              "arrival_timestamp": "timestampadd(MINUTE, 30, arrival_timestamp)",
              "microbatch_id": "microbatch_id + 1"
            }
          }
        ]
      }
    },
    {
